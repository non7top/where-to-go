{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "events.json and concerts.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "category",
      "lon",
      "lat",
      "when",
      "summary"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "category": {
        "enum": [
          "festival",
          "fair",
          "seasonal",
          "holiday",
          "concert"
        ]
      },
      "tier": {
        "enum": [
          1,
          2,
          3
        ]
      },
      "lon": {
        "type": "number",
        "minimum": 60,
        "maximum": 150
      },
      "lat": {
        "type": "number",
        "minimum": -12,
        "maximum": 56
      },
      "when": {
        "type": "string"
      },
      "approx": {
        "type": "boolean"
      },
      "summary": {
        "type": "string"
      },
      "details": {
        "type": "string"
      },
      "crowd": {
        "type": "string"
      },
      "price": {
        "type": "string"
      },
      "perk": {
        "type": "string"
      },
      "areaId": {
        "type": "string"
      },
      "country": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "highlights": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "lon",
            "lat"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "lon": {
              "type": "number",
              "minimum": 60,
              "maximum": 150
            },
            "lat": {
              "type": "number",
              "minimum": -12,
              "maximum": 56
            },
            "note": {
              "type": "string"
            },
            "on": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
            },
            "spread": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            },
            "detail": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "peaks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "spread"
          ],
          "properties": {
            "on": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
            },
            "dates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              }
            },
            "spread": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            },
            "rule": {
              "type": "object",
              "required": [
                "month",
                "nth",
                "weekday"
              ],
              "properties": {
                "month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "nth": {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 5
                },
                "weekday": {
                  "enum": [
                    "sun",
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat"
                  ]
                }
              },
              "additionalProperties": false
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 14
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "on"
              ]
            },
            {
              "required": [
                "rule"
              ]
            },
            {
              "required": [
                "dates"
              ]
            }
          ]
        }
      },
      "fronts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "country",
            "anchors",
            "spread"
          ],
          "properties": {
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "anchors": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "spread": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            },
            "minLat": {
              "type": "number"
            },
            "overrides": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "areaId",
                  "on"
                ],
                "properties": {
                  "areaId": {
                    "type": "string"
                  },
                  "on": {
                    "type": "string",
                    "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
                  },
                  "spread": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 60
                  }
                },
                "additionalProperties": false
              }
            },
            "label": {
              "type": "string"
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "links": {
        "type": "object",
        "properties": {
          "wiki": {
            "type": "string",
            "pattern": "^https://"
          },
          "official": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "additionalProperties": false
      },
      "icon": {
        "enum": [
          "maple",
          "ginkgo",
          "sakura",
          "book",
          "note",
          "drops",
          "lantern",
          "boat",
          "snow",
          "monitor",
          "moon",
          "grass",
          "calendar",
          "star",
          "booth",
          "fireworks",
          "lily",
          "wisteria",
          "hydrangea",
          "lavender",
          "sunflower",
          "plum",
          "cosmos",
          "firefly",
          "whale",
          "sun"
        ]
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "peaks"
        ]
      },
      {
        "required": [
          "fronts"
        ]
      }
    ]
  }
}
