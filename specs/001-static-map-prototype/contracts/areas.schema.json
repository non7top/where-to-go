{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "areas.geojson",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": { "type": "object", "properties": { "type": { "enum": ["Polygon", "MultiPolygon"] } } },
          "properties": {
            "type": "object",
            "required": ["id", "name", "level", "country", "point"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "level": { "enum": ["country", "province", "city", "island"] },
              "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "iata": { "type": "string", "pattern": "^[A-Z]{3}(/[A-Z]{3})*$" },
              "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
            }
          }
        }
      }
    }
  }
}
