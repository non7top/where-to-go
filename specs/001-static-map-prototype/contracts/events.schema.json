{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "events.json and concerts.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "category", "lon", "lat", "months", "when", "summary"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "category": { "enum": ["festival", "fair", "seasonal", "holiday", "concert"] },
      "lon": { "type": "number", "minimum": 60, "maximum": 150 },
      "lat": { "type": "number", "minimum": -12, "maximum": 56 },
      "months": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
      "when": { "type": "string" },
      "approx": { "type": "boolean" },
      "summary": { "type": "string" },
      "details": { "type": "string" },
      "crowd": { "type": "string" },
      "price": { "type": "string" },
      "perk": { "type": "string" },
      "areaId": { "type": "string" }
    },
    "additionalProperties": false
  }
}
